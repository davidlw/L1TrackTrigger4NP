+// ---- TRUTHTRACE (diagnostic, not for production) ----
+namespace {
+  inline bool ttHas(const std::vector<int>& v, int x) { return std::find(v.begin(), v.end(), x) != v.end(); }
+  // TP of a genuine stub (both clusters from it): +tp and -tp present
+  // Dummy stubs carry the TP label of their inner cluster only (+tp); the stub position is
+  // that cluster's, so the inner-cluster TP is the stub's truth here.
+  inline int ttStubTP(const trklet::L1TStub* s) {
+    for (int tp : s->tps())
+      if (tp > 0)
+        return tp;
+    return 0;
+  }
+  // TP shared genuinely by two stubs (as Tracklet::tpseed)
+  inline int ttPairTP(const trklet::L1TStub* a, const trklet::L1TStub* b) {
+    const auto vb = b->tps();
+    for (int tp : a->tps())
+      if (tp > 0 && ttHas(vb, tp))
+        return tp;
+    return 0;
+  }
+}  // namespace
+// ---- end TRUTHTRACE ----
